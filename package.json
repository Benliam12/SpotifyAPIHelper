{
  "name": "@benliam12/spotify-api-helper",
  "version": "1.0.0-DEV.4",
  "description": "A utility package for Node.js",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "test": "node --experimental-vm-modules --no-warnings --env-file=.env.test.local node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --no-warnings --env-file=.env.test.local node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules --no-warnings --env-file=.env.test.local node_modules/jest/bin/jest.js --coverage",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "prepare": "npm run build",
    "release": "semantic-release --no-ci",
    "release:dry": "semantic-release --dry-run --no-ci"
  },
  "keywords": [
    "utility",
    "helpers"
  ],
  "author": "benliam12",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Benliam12/SpotifyAPIHelper.git"
  },
  "bugs": {
    "url": "https://github.com/Benliam12/SpotifyAPIHelper/issues"
  },
  "homepage": "https://github.com/Benliam12/SpotifyAPIHelper#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.3",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "rimraf": "^6.1.2",
    "semantic-release": "^25.0.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
